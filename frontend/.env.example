# RevOps Pro — Frontend environment configuration
# Copy to `.env.local` (git-ignored) and adjust for your machine.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
# this file must only contain PUBLIC values. Never put secrets here.

# Base URL of the FastAPI backend.
# Use the exact host the backend binds to. The dev backend binds 127.0.0.1
# (see scripts/start-dev.ps1) — using "localhost" here can resolve to ::1 and
# fail on Windows.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: set to "1" to always talk to a production API instead.
# NEXT_PUBLIC_API_URL=

