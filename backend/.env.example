# RevOps Pro - Environment Configuration
# Copy this file to .env and fill in your values.
# All secrets are loaded from this file or the process environment.
# Never commit a populated .env.
#
# The .env file is read from backend/.env regardless of the directory you start
# the server from, so `uvicorn` works from the repo root too.
# On Railway/Render you do NOT need this file at all - set the same variables
# in the host dashboard instead, and they take precedence.

# Database (default: backend/data/revops.db)
DATABASE_URL=sqlite:///./data/revops.db

# JWT Authentication
# PRODUCTION: generate a real one, or startup will abort:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to boot with ENVIRONMENT=production if this still looks like
# the placeholder below, or is shorter than 32 characters.
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRE_MINUTES=480

# xAI / Grok AI Provider
# Create a key at https://console.x.ai  (server-side only - never in the browser)
XAI_API_KEY=
# Public xAI endpoint. Overridable only for a proxy or a test mock.
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
XAI_TIMEOUT_SECONDS=30.0

# CORS (comma-separated origins)
# Production: list ONLY your real frontend origin(s). "*" disables protection.
# Local dev needs http://localhost:3000; a Railway/Vercel frontend needs its
# own URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Python Environment
# Set to "production" on your host to enable the startup safety checks.
ENVIRONMENT=development

# Self-service signup
# Set to 0 BEFORE sharing a public URL. While this is on, anyone on the
# internet can register an account and spend your XAI_API_KEY balance.
ALLOW_REGISTRATION=1

# Background jobs (set to 1 to enable APScheduler)
SCHEDULER_ENABLED=0

# Rate limiting (per client IP, in-process)
# Raise LOGIN_RATE_LIMIT if many people share one IP (office, demo room, class),
# otherwise they will lock each other out.
LOGIN_RATE_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT=10
COPILOT_RATE_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60