# RevOps Pro - Environment Configuration
# Copy this file to .env and fill in your values.
# All secrets are loaded from this file or the process environment.
# Never commit a populated .env.

# Database (default: backend/data/revops.db)
DATABASE_URL=sqlite:///./data/revops.db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRE_MINUTES=480

# OmniRoute AI Provider
OMNIROUTE_BASE_URL=http://localhost:8080
OMNIROUTE_API_KEY=your-omni-route-api-key
OMNIROUTE_MODEL=revops-ai-v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Python Environment
ENVIRONMENT=development

# Background jobs (set to 1 to enable APScheduler)
SCHEDULER_ENABLED=0